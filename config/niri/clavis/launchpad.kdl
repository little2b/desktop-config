binds {
    // keyd sends KEY_F13; the standard evdev XKB map names it XF86Tools.
    XF86Tools repeat=false hotkey-overlay-title="应用菜单：单击 Win" {
        spawn "qs" "-c" "clavis" "ipc" "call" "launchpad" "toggle";
    }
    // Also support keymaps which keep the literal F13 keysym.
    F13 repeat=false hotkey-overlay-title=null {
        spawn "qs" "-c" "clavis" "ipc" "call" "launchpad" "toggle";
    }
}
