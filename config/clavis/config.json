{
  "wallpaper": {
    "bannerSource": "",
    "folder": "@HOME@/Pictures/Wallpapers",
    "path": "@HOME@/Pictures/Wallpapers/current.jpg",
    "pathLight": "",
    "pathDark": "",
    "perMode": false,
    "perMonitor": false,
    "monitorWallpapers": {},
    "monitorFillModes": {},
    "recentColors": [],
    "fillMode": "Fill",
    "desktopBackend": "quickshell",
    "autoCycle": {
      "enabled": false,
      "mode": "interval",
      "interval": 300,
      "time": "06:00"
    },
    "transition": {
      "type": "fade",
      "included": [
        "fade",
        "wipe",
        "disc",
        "stripes",
        "iris bloom",
        "pixelate",
        "portal"
      ],
      "durationMs": 1000,
      "easingMode": "customBezier",
      "bezierCurve": [
        0.43,
        1.19,
        1,
        0.4,
        1,
        1
      ]
    },
    "awww": {
      "transitionType": "fade",
      "transitionFps": 60,
      "transitionStep": 90,
      "transitionAngle": 45,
      "transitionPosition": "center",
      "transitionWave": "20,20"
    },
    "overview": {
      "enabled": true,
      "useDesktopWallpaper": true,
      "path": "",
      "fillMode": "Fill",
      "perMonitor": false,
      "monitorWallpapers": {},
      "monitorFillModes": {},
      "transitionType": "fade",
      "blurRadius": 0,
      "dim": 0,
      "saturation": 1,
      "contrast": 1
    },
    "parallax": {
      "verticalEnabled": false,
      "followWorkspaces": true,
      "followSidebars": false,
      "followTiledColumns": false,
      "preferredScale": 1.1,
      "tiledColumnSpan": 6
    }
  },
  "theme": {
    "matugenScheme": "scheme-tonal-spot",
    "matugenTemplates": {
      "btop": true,
      "cava": true,
      "kitty": true,
      "yazi": true
    },
    "mode": "light",
    "superKeyStyle": "text",
    "lockScreenStyle": "default",
    "cursorTheme": "capitaine-cursors",
    "cursorSize": 24,
    "cursorHideWhenTyping": false,
    "cursorHideAfterInactiveMs": 0,
    "iconTheme": "",
    "fonts": {
      "ui": "LXGW WenKai GB Screen",
      "mono": "JetBrainsMono Nerd Font Mono",
      "numeric": "JetBrainsMono Nerd Font Mono",
      "expressive": "Google Sans Flex"
    }
  },
  "effects": {
    "shellBackgroundOpacity": 0.18,
    "shellBlurEnabled": true,
    "shellBlurXray": false
  },
  "keystone": {
    "style": "pill",
    "position": "top",
    "capsLockOsd": true,
    "numLockOsd": true,
    "hideDate": true,
    "hoverAction": "peak",
    "leftClickAction": "dashboard",
    "middleClickAction": "lyrics",
    "keyhole": {
      "cards": [
        "weather",
        "quickSettings",
        "pomodoro"
      ]
    },
    "horizontalClock": {
      "fontSize": 28,
      "axes": {
        "wght": 900,
        "wdth": 85,
        "opsz": 47,
        "GRAD": 0,
        "ROND": 23,
        "slnt": 0
      },
      "digits": {
        "h0": {
          "x": 0,
          "y": -2,
          "rotation": -3,
          "colorRole": "inversePrimary",
          "customColor": ""
        },
        "h1": {
          "x": 0,
          "y": 1,
          "rotation": 3,
          "colorRole": "primary",
          "customColor": ""
        },
        "m0": {
          "x": 0,
          "y": -1,
          "rotation": -2,
          "colorRole": "inversePrimary",
          "customColor": ""
        },
        "m1": {
          "x": 0,
          "y": 1,
          "rotation": 2,
          "colorRole": "primary",
          "customColor": ""
        },
        "ap": {
          "x": 1,
          "y": -2,
          "rotation": -2,
          "colorRole": "inversePrimary",
          "customColor": ""
        },
        "periodM": {
          "x": 1,
          "y": 1,
          "rotation": 2,
          "colorRole": "primary",
          "customColor": ""
        }
      }
    }
  },
  "bar": {
    "position": "top",
    "edgeMargin": 0,
    "barLeadingComponents": [
      "workspaces",
      "information",
      "activeWindow"
    ],
    "barTrailingComponents": [
      "tray",
      "quickSettings"
    ],
    "quickSettingsComponents": [
      "network",
      "bluetooth",
      "brightness",
      "volume",
      "microphone",
      "battery",
      "settings",
      "power"
    ]
  },
  "sidebar": {
    "keepLoaded": true,
    "dashboardSide": "left",
    "quickSettingsSide": "right"
  },
  "desktopCards": {
    "gridSnapEnabled": true,
    "gridVisibleWhileDragging": true
  }
}
