/* Generated from Clavis; includes the file-view palette bridge. */
QWidget { color: #181c1f; selection-color: #001e2c; selection-background-color: #c4e7ff; }
QMainWindow, QDialog, QToolBar, QDockWidget, QMenuBar { background-color: #eaeef3; }
DolphinView, DolphinView QGraphicsView, DolphinView QGraphicsView QWidget { color: #181c1f; background-color: #f6fafe; }
QAbstractItemView { background-color: #f6fafe; alternate-background-color: #f0f4f8; }
QMenu, QToolTip { background-color: #e5e8ed; color: #181c1f; border: 1px solid #c0c7cd; }
QMenu::item:selected, QToolButton:hover { background-color: #c4e7ff; color: #001e2c; }
QLineEdit { color: #181c1f; background-color: #f6fafe; selection-background-color: #c4e7ff; selection-color: #001e2c; }
